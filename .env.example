# DocuVieware license key (also unlocks the GdPicture classes). Empty = evaluation mode.
DOCUVIEWARE_LICENSE_KEY=
# Nutrient Web SDK license key, served to the page by GET /api/config. Empty = evaluation mode.
NUTRIENT_WEB_LICENSE_KEY=
# Public base URL of the app; it is also the address the server listens on.
APP_URI=http://localhost:5050
